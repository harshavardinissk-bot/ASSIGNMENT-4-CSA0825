from decimal import Decimal, InvalidOperation
import tempfile, os
def process_bills(filename):
    total=Decimal("0.00"); report=[]; rejected=[]
    try:
        with open(filename,encoding="utf-8") as f:
            for n,raw in enumerate(f,1):
                if not raw.strip(): continue
                try:
                    reg,name,amount=raw.strip().split(",",2)
                    value=Decimal(amount.strip()); total+=value
                    report.append(f"{reg.strip()} {name.strip()} {value:.2f}")
                except (ValueError,InvalidOperation) as exc:
                    rejected.append((n,raw.rstrip(),str(exc)))
    except (FileNotFoundError,PermissionError,UnicodeDecodeError) as exc:
        raise OSError(f"cannot read {filename}") from exc
    return total,report,rejected
